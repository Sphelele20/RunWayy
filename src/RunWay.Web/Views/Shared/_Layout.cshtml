<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>@ViewData["Title"] · RaceDay</title>
<link rel="stylesheet" href="/css/bootstrap.min.css"/><link rel="stylesheet" href="/css/site.css"/></head>
<body><a class="skip" href="#main">Skip to content</a>
<header><nav class="container nav-row" aria-label="Main navigation"><a class="brand" asp-controller="Events" asp-action="Index">RaceDay<span> / GO FURTHER</span></a>
<div class="nav-links"><a asp-controller="Events" asp-action="Index">Explore events</a>
@if(User.IsInRole("Organiser")){<a asp-controller="Organiser" asp-action="Dashboard">My dashboard</a><a asp-controller="Organiser" asp-action="Create">Create event</a>}
@if(User.IsInRole("Participant")){<a asp-controller="Participant" asp-action="Entries">My entries</a><a asp-controller="Participant" asp-action="Results">My results</a>}
@if(User.Identity?.IsAuthenticated==true){
<a asp-controller="Account" asp-action="Profile">Profile</a><form asp-controller="Account" asp-action="Logout" method="post"><button class="nav-button" type="submit">Sign out</button></form>
}else{<a asp-controller="Account" asp-action="Login">Sign in</a><a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Join RaceDay</a>}</div></nav></header>
<main id="main" class="container">
@if(TempData["Success"] is string success){<div class="alert alert-success" role="status">@success</div>}
@if(TempData["Error"] is string error){<div class="alert alert-danger" role="alert">@error</div>}
@RenderBody()</main>
<footer class="container">RaceDay · Every start line is a new possibility. <span>Running / Walking / Cycling</span></footer>
<script src="/js/site.js"></script></body></html>
@model EventDto
@{ViewData["Title"]=Model.Name;}
<a class="back-link" asp-action="Index">← All events</a>
@if(Model.BannerUrl!=null){<img class="detail-cover" src="@Model.BannerUrl" alt="@Model.Name banner"/>}
<section class="detail-grid"><div><p class="eyebrow">@Model.EventType / @Model.Distance KM</p><h1>@Model.Name</h1><p class="lede">@Model.Location · @Model.Date.ToString("dd MMM yyyy, HH:mm") UTC</p><p class="description">@Model.Description</p></div>
<aside class="panel"><p class="eyebrow">YOUR PLACE ON THE START LINE</p><h2>Choose your category</h2>
@if(Model.Categories.Count==0){<p>Categories will be announced soon.</p>}else{<ul>@foreach(var c in Model.Categories){<li><strong>@c.Name</strong> @c.Description</li>}</ul>
@if(User.IsInRole("Participant")&&Model.Date>DateTime.UtcNow){<form asp-action="Enrol" asp-route-id="@Model.Id" method="post"><label for="categoryId">Race category</label><select id="categoryId" name="categoryId" class="form-select" required><option value="">Choose a category</option>@foreach(var c in Model.Categories){<option value="@c.Id">@c.Name</option>}</select><button class="btn btn-primary mt-3" type="submit">Enter this event →</button></form>}
else if(User.Identity?.IsAuthenticated!=true){<a class="btn btn-primary" asp-controller="Account" asp-action="Login">Sign in to enter</a>}
else if(Model.Date<=DateTime.UtcNow){<p>Entries are closed.</p>}}
</aside></section>
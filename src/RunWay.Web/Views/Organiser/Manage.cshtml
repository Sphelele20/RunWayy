@model EventDto
@{ViewData["Title"]="Manage "+Model.Name;var entries=(List<EnrolmentDto>)ViewBag.Enrolments;}
<a class="back-link" asp-action="Dashboard">← Dashboard</a><p class="eyebrow">EVENT CONTROL</p><h1>@Model.Name</h1><p>@Model.Date.ToString("dd MMM yyyy, HH:mm") UTC · @Model.Location</p>
<div class="action-row"><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit event & banner</a><a class="btn btn-outline-dark" asp-controller="Events" asp-action="Details" asp-route-id="@Model.Id">Public event page</a><form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-confirm="Delete this event, its entries and results?"><button class="btn btn-outline-danger" type="submit">Delete event</button></form></div>
<section class="panel"><h2>Race categories</h2><ul class="category-list">@foreach(var c in Model.Categories){<li><span><strong>@c.Name</strong> @c.Description</span><form asp-action="RemoveCategory" asp-route-id="@Model.Id" method="post"><input type="hidden" name="categoryId" value="@c.Id"/><button class="btn btn-sm btn-outline-danger" type="submit">Remove</button></form></li>}</ul>
<form asp-action="AddCategory" asp-route-id="@Model.Id" method="post" class="filter-bar"><div><label for="Name">Category name</label><input id="Name" name="Name" maxlength="100" required class="form-control"/></div><div><label for="Description">Description</label><input id="Description" name="Description" maxlength="255" class="form-control"/></div><button class="btn btn-primary" type="submit">Add category</button></form></section>
<h2 class="mt-5">Start list & results <small>(@entries.Count)</small></h2><p>Results can be published after the event date. Enter times as HH:mm:ss.</p>
@if(entries.Count==0){<p class="empty">No participants have entered yet.</p>}
<div class="table-responsive"><table class="table"><thead><tr><th>Participant</th><th>Category</th><th>Status</th><th>Finish time / position</th></tr></thead><tbody>@foreach(var n in entries){<tr><td>@n.ParticipantName</td><td>@n.Category</td><td><span class="status @n.Status.ToLowerInvariant()">@n.Status</span></td><td>
@if(Model.Date<=DateTime.UtcNow){<form asp-action="PublishResult" asp-route-id="@Model.Id" method="post" class="result-form"><input type="hidden" name="enrolmentId" value="@n.Id"/><input aria-label="Finish time for @n.ParticipantName" name="FinishTime" value="@n.FinishTime" placeholder="01:32:18" pattern="[0-9]{2,3}:[0-5][0-9]:[0-5][0-9]" required class="form-control"/><input aria-label="Position for @n.ParticipantName" type="number" name="Position" value="@(n.Position??1)" min="1" required class="form-control"/><button class="btn btn-primary btn-sm" type="submit">Publish</button></form>}else{<span>Available after the event</span>}</td></tr>}</tbody></table></div>
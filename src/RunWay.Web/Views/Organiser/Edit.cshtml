@model EventRequest
@{ViewData["Title"]=Model.Id==0?"Create event":"Edit event";}
<p class="eyebrow">BUILD A GREAT RACE DAY</p><h1>@ViewData["Title"]</h1>
<form asp-action="Save" method="post" enctype="multipart/form-data" class="panel narrow"><input asp-for="Id" type="hidden"/><div asp-validation-summary="All" class="text-danger" role="alert"></div>
<label asp-for="Name">Event name</label><input asp-for="Name" class="form-control"/>
<label asp-for="Description"></label><textarea asp-for="Description" class="form-control" rows="5"></textarea>
<label asp-for="Location"></label><input asp-for="Location" class="form-control"/>
<label asp-for="Date">Date and time (UTC)</label><input asp-for="Date" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control"/>
<label asp-for="Distance">Distance (km)</label><input asp-for="Distance" type="number" step="0.1" min="0.1" max="1000" class="form-control"/>
<label asp-for="EventType">Event type</label><select asp-for="EventType" class="form-select"><option>Running</option><option>Walking</option><option>Cycling</option></select>
<label for="banner">Event banner (PNG or JPEG, up to 2 MB)</label><input type="file" id="banner" name="banner" accept="image/png,image/jpeg" class="form-control"/>
<button type="submit" class="btn btn-primary mt-4">Save event →</button><a class="ms-3" asp-action="Dashboard">Cancel</a></form>
@model LoginRequest
@{ViewData["Title"]="Welcome back";}
<section class="auth-layout"><div><p class="eyebrow">BACK FOR YOUR NEXT CHALLENGE</p><h1>Your next<br/><em>start line awaits.</em></h1><p>Sign in to manage your events, entries and personal results.</p></div><form method="post" class="panel"><h2>Sign in</h2><div asp-validation-summary="All" class="text-danger" role="alert"></div><label asp-for="Email"></label><input asp-for="Email" class="form-control" autocomplete="username"/><label asp-for="Password"></label><input asp-for="Password" type="password" class="form-control" autocomplete="current-password"/><button class="btn btn-primary mt-4" type="submit">Let's go →</button><p class="mt-3">New to RaceDay? <a asp-action="Register">Create an account</a></p></form></section>
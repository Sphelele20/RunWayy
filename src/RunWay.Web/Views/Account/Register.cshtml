@model RegisterRequest
@{ViewData["Title"]="Join RaceDay";}
<section class="auth-layout"><div><p class="eyebrow">EVERY JOURNEY HAS A START LINE</p><h1>Make your<br/><em>next move.</em></h1><p>Join as a participant to enter races, or as an organiser to create your own.</p></div><form method="post" class="panel"><h2>Create your account</h2><div asp-validation-summary="All" class="text-danger" role="alert"></div>
<label asp-for="FirstName">First name</label><input asp-for="FirstName" class="form-control" autocomplete="given-name"/>
<label asp-for="LastName">Last name</label><input asp-for="LastName" class="form-control" autocomplete="family-name"/>
<label asp-for="Email"></label><input asp-for="Email" class="form-control" autocomplete="username"/>
<label asp-for="Gender"></label><select asp-for="Gender" class="form-select"><option>PreferNotToSay</option><option>Female</option><option>Male</option><option>Other</option></select>
<label asp-for="Role">I want to join as</label><select asp-for="Role" class="form-select"><option>Participant</option><option>Organiser</option></select>
<label asp-for="Password"></label><input asp-for="Password" type="password" class="form-control" autocomplete="new-password"/><small>At least 8 characters, with uppercase, lowercase, a number and a symbol.</small>
<button class="btn btn-primary mt-4" type="submit">Join RaceDay →</button></form></section>
@model ProfileViewModel
@{
    ViewData["Title"] = "My profile";
    var img = UiHelpers.ImageUrl(Model.ProfileImage);
}
<h1 class="page-title">My profile</h1>

<div class="row g-4">
    <div class="col-md-4">
        <div class="rd-panel text-center">
            @if (img != null)
            {
                <img src="@img" class="profile-avatar mb-3" alt="Your profile picture" />
            }
            else
            {
                <span class="profile-avatar profile-avatar-fallback mb-3">@(Model.FirstName.Length > 0 ? Model.FirstName.Substring(0, 1).ToUpper() : "?")</span>
            }
            <h2 class="h4 mb-0">@Model.FirstName @Model.LastName</h2>
            <p class="text-muted">@string.Join(", ", Model.Roles)</p>

            <form asp-action="UploadPicture" method="post" enctype="multipart/form-data" class="text-start">
                <label class="form-label" for="picture">Change profile picture</label>
                <input type="file" id="picture" name="picture" class="form-control mb-2" accept=".jpg,.jpeg,.png,.webp" required />
                <button type="submit" class="btn btn-outline-primary w-100">Upload picture</button>
            </form>
        </div>
    </div>
    <div class="col-md-8">
        <div class="rd-panel">
            <h2 class="rd-panel-title">Personal information</h2>
            <form asp-action="Update" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label asp-for="FirstName" class="form-label"></label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="LastName" class="form-label"></label>
                        <input asp-for="LastName" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="email">Email</label>
                        <input id="email" class="form-control" value="@Model.Email" disabled />
                        <input type="hidden" asp-for="Email" />
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Gender" class="form-label"></label>
                        <select asp-for="Gender" class="form-select">
                            @foreach (var g in Enum.GetValues<Gender>())
                            {
                                <option value="@g" selected="@(Model.Gender == g)">@UiHelpers.GenderLabel(g)</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <input asp-for="PhoneNumber" class="form-control" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary mt-4">Save changes</button>
            </form>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

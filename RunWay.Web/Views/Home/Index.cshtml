@model HomeViewModel
@{
    ViewData["Title"] = "Upcoming events";
    var f = Model.Filter;
}

<section class="rd-hero">
    <h1>Find your next race</h1>
    <p>Browse upcoming running events, pick your distance and enrol in minutes.</p>
    @if (User.Identity?.IsAuthenticated != true)
    {
        <div class="mt-3">
            <a class="btn btn-primary me-2" asp-controller="Account" asp-action="Register">Create an account</a>
            <a class="btn btn-outline-light" asp-controller="Account" asp-action="Login">Log in</a>
        </div>
    }
</section>

<form method="get" asp-controller="Home" asp-action="Index" class="rd-panel mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-lg-4 col-md-6">
            <label class="form-label" for="Search">Search</label>
            <input class="form-control" id="Search" name="Search" value="@f.Search" placeholder="Name, place or keyword" maxlength="100" />
        </div>
        <div class="col-lg-2 col-md-6">
            <label class="form-label" for="Type">Event type</label>
            <select class="form-select" id="Type" name="Type">
                <option value="">All types</option>
                @foreach (var t in Enum.GetValues<EventType>())
                {
                    <option value="@t" selected="@(f.Type == t)">@UiHelpers.TypeLabel(t)</option>
                }
            </select>
        </div>
        <div class="col-lg-3 col-md-6">
            <label class="form-label" for="From">From</label>
            <input type="date" class="form-control" id="From" name="From" value="@f.From?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-lg-3 col-md-6">
            <label class="form-label" for="To">To</label>
            <input type="date" class="form-control" id="To" name="To" value="@f.To?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-lg-2 col-6">
            <label class="form-label" for="MinDistance">Min km</label>
            <input type="number" step="0.1" min="0" class="form-control" id="MinDistance" name="MinDistance" value="@f.MinDistance" />
        </div>
        <div class="col-lg-2 col-6">
            <label class="form-label" for="MaxDistance">Max km</label>
            <input type="number" step="0.1" min="0" class="form-control" id="MaxDistance" name="MaxDistance" value="@f.MaxDistance" />
        </div>
        <div class="col-lg-8 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Filter events</button>
            @if (f.HasFilters)
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Clear filters</a>
            }
        </div>
    </div>
</form>

<h2 class="page-title">@(f.HasFilters ? "Matching events" : "Upcoming events") <small class="text-muted fs-6">(@Model.Events.Count)</small></h2>

@if (Model.Events.Count == 0)
{
    <div class="rd-panel text-center py-5">
        <p class="lead mb-1">No events found.</p>
        <p class="text-muted mb-0">@(f.HasFilters ? "Try widening your filters." : "Check back soon for new races.")</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var ev in Model.Events)
        {
            <div class="col-sm-6 col-lg-4"><partial name="_EventCard" model="ev" /></div>
        }
    </div>
}

@model EventFormViewModel
@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? "Edit event" : "Create event";
    var existing = UiHelpers.ImageUrl(Model.ExistingBanner);
}
<h1 class="page-title">@ViewData["Title"]</h1>

<div class="rd-panel">
    <form asp-action="@(isEdit ? "EditEvent" : "CreateEvent")" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <input type="hidden" asp-for="ExistingBanner" />
        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" maxlength="150" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="EventType" class="form-label"></label>
                <select asp-for="EventType" class="form-select">
                    @foreach (var t in Enum.GetValues<EventType>())
                    {
                        <option value="@t" selected="@(Model.EventType == t)">@UiHelpers.TypeLabel(t)</option>
                    }
                </select>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4" maxlength="2000"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Date" class="form-label"></label>
                <input asp-for="Date" type="datetime-local" class="form-control" />
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="Location" class="form-label"></label>
                <input asp-for="Location" class="form-control" maxlength="200" />
                <span asp-validation-for="Location" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="DistanceKm" class="form-label"></label>
                <input asp-for="DistanceKm" type="number" step="0.1" min="0.1" class="form-control" />
                <span asp-validation-for="DistanceKm" class="text-danger"></span>
            </div>
            <div class="col-12">
                <label asp-for="Banner" class="form-label"></label>
                @if (existing != null)
                {
                    <div class="mb-2"><img src="@existing" alt="Current banner" style="max-height:120px;border-radius:8px" /></div>
                }
                <input asp-for="Banner" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                <div class="form-text">JPG, PNG or WebP, up to 5 MB. Stored in Azure Blob Storage through the API.</div>
                <span asp-validation-for="Banner" class="text-danger"></span>
            </div>
        </div>
        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">@(isEdit ? "Save changes" : "Create event")</button>
            <a asp-action="Events" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

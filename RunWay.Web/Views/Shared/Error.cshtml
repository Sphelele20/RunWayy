@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}
<div class="text-center py-5">
    @if (Model.StatusCode.HasValue)
    {
        <p class="display-1 rd-display text-primary mb-0">@Model.StatusCode</p>
    }
    <h1 class="rd-display">@(Model.Message ?? "Sorry, something went wrong.")</h1>
    <p class="text-muted">Please try again, or head back to the events page.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to events</a>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted mt-4">Reference: <code>@Model.RequestId</code></p>
    }
</div>

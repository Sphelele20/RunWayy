@model EventDto
@{
    var img = UiHelpers.ImageUrl(Model.BannerImage);
}
<div class="card event-card h-100">
    @if (img != null)
    {
        <img src="@img" class="event-card-img" alt="Banner for @Model.Name" loading="lazy" />
    }
    else
    {
        <div class="event-card-img event-card-placeholder" role="img" aria-label="No banner image"><span>@UiHelpers.TypeLabel(Model.EventType)</span></div>
    }
    <div class="card-body d-flex flex-column">
        <div class="mb-2">
            <span class="type-pill">@UiHelpers.TypeLabel(Model.EventType)</span>
            <span class="type-pill type-pill-dark">@Model.DistanceKm.ToString("0.#") km</span>
        </div>
        <h3 class="h5 card-title">@Model.Name</h3>
        <p class="card-text text-muted small mb-1">&#128197; @Model.Date.ToString("ddd, d MMM yyyy 'at' HH:mm")</p>
        <p class="card-text text-muted small mb-2">&#128205; @Model.Location</p>
        @if (Model.Categories.Any())
        {
            <p class="small mb-3">
                @foreach (var c in Model.Categories)
                {
                    <span class="badge text-bg-light border">@c.Name</span>
                }
            </p>
        }
        <a asp-controller="Events" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-primary mt-auto">View event</a>
    </div>
</div>

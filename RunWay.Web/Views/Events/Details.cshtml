@model EventDetailsViewModel
@{
    var ev = Model.Event;
    ViewData["Title"] = ev.Name;
    var img = UiHelpers.ImageUrl(ev.BannerImage);
}

<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Events</a></li><li class="breadcrumb-item active" aria-current="page">@ev.Name</li></ol></nav>

@if (img != null)
{
    <img src="@img" class="event-banner mb-4" alt="Banner for @ev.Name" />
}
else
{
    <div class="event-card-placeholder event-banner-placeholder mb-4"><span>@UiHelpers.TypeLabel(ev.EventType)</span></div>
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="rd-panel mb-4">
            <div class="mb-2">
                <span class="type-pill">@UiHelpers.TypeLabel(ev.EventType)</span>
                <span class="type-pill type-pill-dark">@ev.DistanceKm.ToString("0.#") km</span>
                @if (ev.IsPast) { <span class="type-pill type-pill-dark">Finished</span> }
            </div>
            <h1 class="mb-3">@ev.Name</h1>
            <p class="mb-1"><strong>&#128197; When:</strong> @ev.Date.ToString("dddd, d MMMM yyyy 'at' HH:mm")</p>
            <p class="mb-1"><strong>&#128205; Where:</strong> @ev.Location</p>
            <p class="mb-3"><strong>&#128100; Organiser:</strong> @ev.OrganiserName &middot; @ev.EnrolmentCount enrolled</p>
            <p class="mb-0" style="white-space: pre-line">@ev.Description</p>
        </div>

        @if (ev.IsPast)
        {
            <div class="rd-panel">
                <h2 class="rd-panel-title">Results</h2>
                @if (Model.Results.Count == 0)
                {
                    <p class="text-muted mb-0">Results have not been published yet.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead><tr><th>Pos</th><th>Runner</th><th>Category</th><th>Time</th></tr></thead>
                            <tbody>
                                @foreach (var r in Model.Results)
                                {
                                    <tr>
                                        <td><span class="position-badge @(r.Position == 1 ? "position-1" : "")">@r.Position</span></td>
                                        <td>@r.ParticipantName</td>
                                        <td>@r.CategoryName</td>
                                        <td>@UiHelpers.FormatTime(r.FinishTime)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="rd-panel">
            <h2 class="rd-panel-title">Categories</h2>
            @if (ev.Categories.Count == 0)
            {
                <p class="text-muted">The organiser has not added categories yet.</p>
            }
            else
            {
                <ul class="list-group list-group-flush mb-3">
                    @foreach (var c in ev.Categories)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span>@c.Name</span><span class="type-pill type-pill-dark">@c.DistanceKm.ToString("0.#") km</span>
                        </li>
                    }
                </ul>
            }

            @if (ev.IsPast)
            {
                <div class="alert alert-secondary mb-0">This event has finished. Enrolment is closed.</div>
            }
            else if (User.Identity?.IsAuthenticated != true)
            {
                <a class="btn btn-primary w-100" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Details", "Events", new { id = ev.Id })">Log in to enrol</a>
            }
            else if (User.IsInRole("Participant"))
            {
                if (Model.MyEnrolment != null)
                {
                    <div class="alert alert-light border mb-3">
                        You are enrolled in <strong>@Model.MyEnrolment.CategoryName</strong><br />
                        Status: <partial name="_StatusBadge" model="Model.MyEnrolment.Status" />
                    </div>
                    <a class="btn btn-outline-primary w-100" asp-controller="Enrolments" asp-action="Index">View my enrolments</a>
                }
                else if (ev.Categories.Count > 0)
                {
                    <form asp-controller="Enrolments" asp-action="Create" method="post">
                        <input type="hidden" name="eventId" value="@ev.Id" />
                        <label class="form-label" for="categoryId">Choose your category</label>
                        <select class="form-select mb-3" id="categoryId" name="categoryId" required>
                            <option value="">Select a category...</option>
                            @foreach (var c in ev.Categories)
                            {
                                <option value="@c.Id">@c.Name (@c.DistanceKm.ToString("0.#") km)</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-primary w-100">Enrol now</button>
                    </form>
                }
            }
            else
            {
                <div class="alert alert-secondary mb-0">Only participant accounts can enrol in events.</div>
            }
        </div>
    </div>
</div>
